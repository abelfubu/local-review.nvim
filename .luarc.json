{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"Lua": {
		"runtime": {
			"version": "LuaJIT",
			"pathStrict": false,
			"path": [
				"?.lua",
				"?/init.lua",
				"lua/?.lua",
				"lua/?/init.lua"
			]
		},
		"workspace": {
			"checkThirdParty": false,
			"library": [
				"$VIMRUNTIME/lua",
				"$VIMRUNTIME/lua/vim/_meta"
			]
		}
	}
}
